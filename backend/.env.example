# Owner/superuser connection - used for `prisma migrate` and `prisma db seed`.
# This role must be able to create tables, roles, and policies.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pulsepoint"

# Restricted, non-owner connection the running server uses so that Postgres
# Row Level Security is actually enforced. Created by the RLS migration
# (role: pulsepoint_app / password: pulsepoint_app by default - see
# backend/prisma/migrations/20260806000001_row_level_security).
APP_DATABASE_URL="postgresql://pulsepoint_app:pulsepoint_app@localhost:5432/pulsepoint"

JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000

# Origin the frontend dev server runs on, for CORS + cookies
CORS_ORIGIN="http://localhost:5173"
